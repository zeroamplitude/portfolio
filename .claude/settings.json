{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/seo-check.py\"",
            "timeout": 30,
            "statusMessage": "Checking site SEO before commit"
          }
        ]
      }
    ]
  }
}
